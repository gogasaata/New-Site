# --- Admin panel (REQUIRED to use /admin) ---
ADMIN_PASSWORD=change-me-to-a-long-password
# Optional: separate secret used to sign the session cookie (falls back to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# --- Supabase (OPTIONAL: the site works with built-in default text without these) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
