# --- Admin panel (REQUIRED to use /admin) ---
# Password you type on /admin. Use a long, unique one (12+ characters).
ADMIN_PASSWORD=change-me-to-a-long-password
# Secret used to sign the login cookie. MUST be different from the password: 24+ random characters.
# Generate one with:  openssl rand -base64 36
ADMIN_SESSION_SECRET=

# --- Supabase (OPTIONAL for viewing the site; REQUIRED to save edits and receive contact-form leads) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only key. NEVER prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- E-mail notification for new contact-form messages (OPTIONAL, via resend.com) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
